{
  "name": "cagent",
  "description": "Extensible Bun/TypeScript coding agent with plugins and a terminal UI",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "sdk",
    "plugins/*"
  ],
  "scripts": {
    "start": "bun core/src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --linter-enabled=true --formatter-enabled=false .",
    "build": "bun run build:release",
    "verify": "bun run build && bun run typecheck && bun run lint && bun test",
    "knip": "knip --exclude files,exports,types",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "graph:update": "graphify update .",
    "check:plugins": "bun plugins/metadata.ts",
    "build:release": "bun scripts/build-release.ts && bun build release.ts --compile --outfile dist/cagent",
    "check:module-limits": "bun scripts/check-module-limits.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@opentui/react": "^0.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "bun-types": "1.3.5",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "typescript": "^5.9.3"
  }
}
