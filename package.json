{
  "name": "cagent",
  "description": "Extensible Bun/TypeScript coding agent with plugins and a terminal UI",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": ["core", "sdk", "plugins/*"],
  "scripts": {
    "start": "bun core/src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit --noCheck",
    "lint": "biome check --linter-enabled=true --formatter-enabled=false .",
    "format": "biome format --write .",
    "graph:update": "graphify update .",
    "build:release": "bun build release.ts --compile --outfile dist/cagent",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.3.0",
    "bun-types": "^1.4.2",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
